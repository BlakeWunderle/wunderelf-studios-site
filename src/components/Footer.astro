---
import { navLinks } from "../data/nav";
import ElfLogo from "./ElfLogo.astro";
import { products } from "../data/products";

const year = new Date().getFullYear();

const themes = [
  { value: "system", label: "System" },
  { value: "light", label: "Light" },
  { value: "dark", label: "Dark" },
];
---

<footer class="border-t border-border-subtle bg-surface-raised">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-3">
          <ElfLogo class="h-10 w-10" />
          <span class="text-base font-bold tracking-tight text-text">Wunderelf Studios</span>
        </div>
        <p class="mt-3 text-sm text-text-muted leading-relaxed">
          Games and apps, built with care.
        </p>
      </div>

      <!-- Links -->
      <div>
        <h3 class="text-[11px] font-semibold uppercase tracking-wide text-text-faint mb-3">Navigate</h3>
        <ul class="space-y-2">
          {navLinks.map((link) => (
            <li><a href={link.href} class="text-sm text-text-muted hover:text-text transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Social and theme -->
      <div class="space-y-8">
        <div>
          <h3 class="text-[11px] font-semibold uppercase tracking-wide text-text-faint mb-3">Get Our Products</h3>
          <ul class="space-y-2">
            {products.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-sm text-text-muted hover:text-text transition-colors" data-track={p.track} data-location="footer">
                  {p.name} <span class="text-text-faint" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Three states, not two, as in the app: a two-way toggle stops following the OS the first time it is touched. -->
        <div>
          <h3 id="theme-label" class="text-[11px] font-semibold uppercase tracking-wide text-text-faint mb-3">Theme</h3>
          <div role="radiogroup" aria-labelledby="theme-label" class="inline-flex rounded-lg border border-border-subtle bg-surface p-0.5">
            {themes.map((t) => (
              <button
                type="button"
                role="radio"
                aria-checked="false"
                data-theme-choice={t.value}
                class="theme-choice min-h-9 rounded-md px-3 text-sm text-text-muted transition-colors aria-checked:bg-accent aria-checked:font-semibold aria-checked:text-accent-contrast"
              >
                {t.label}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-border-subtle text-center">
      <p class="text-xs text-text-faint">
        &copy; {year} Wunderelf Studios. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<script>
  // BaseLayout's head script owns applying the theme; this only stores the choice and re-applies it.
  const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-choice");

  function current(): string {
    try {
      return localStorage.getItem("theme") ?? "system";
    } catch {
      return "system";
    }
  }

  function mark(choice: string) {
    buttons.forEach((b) => b.setAttribute("aria-checked", String(b.dataset.themeChoice === choice)));
  }

  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const choice = b.dataset.themeChoice ?? "system";
      try {
        localStorage.setItem("theme", choice);
      } catch {
        // Storage blocked (private window): the choice still applies for this page view.
      }
      (window as any).applyTheme?.(choice);
      mark(choice);
    }),
  );

  mark(current());
</script>

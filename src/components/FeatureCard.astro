---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="bg-surface border border-border-subtle rounded-xl p-5">
  <h3 class="text-base font-semibold text-text mb-1.5">
    {title}
  </h3>
  <p class="text-sm text-text-muted leading-relaxed">
    {description}
  </p>
</div>

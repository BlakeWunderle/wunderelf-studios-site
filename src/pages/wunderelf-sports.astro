---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ScreenshotGallery from "../components/ScreenshotGallery.astro";

const appUrl = "https://wunderelfsports.com";

// Rendered from a seeded demo pool; every name is made up and no team logos appear.
const screenshots = [
  { src: "/images/sports/01-pool-games.webp", alt: "This week's games, picked" },
  { src: "/images/sports/02-pool-grid.webp", alt: "A finished week's picks grid" },
  { src: "/images/sports/04-pool-season-standings.webp", alt: "Season standings" },
  { src: "/images/sports/05-pool-shared-picks.webp", alt: "Picks shared before kickoff" },
  { src: "/images/sports/06-pool-following.webp", alt: "Week standings narrowed to followed players" },
  { src: "/images/sports/07-nfl-scoreboard.webp", alt: "NFL scoreboard" },
  { src: "/images/sports/08-game-boxscore.webp", alt: "Game box score" },
];
---

<BaseLayout
  title="Wunderelf Sports"
  description="Weekly NFL pick'em pools for your group, plus live scores from 34 leagues. On the web, iPhone and Android."
  ogImage="/images/sports/hero-og.jpg"
>
  <!-- Hero -->
  <section class="relative py-24 overflow-hidden">
    <div class="relative z-10 max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="text-center lg:text-left">
        <h1 class="tracking-tight text-5xl md:text-6xl font-bold mb-4">
          Wunderelf <span class="text-accent">Sports</span>
        </h1>
        <p class="text-xl text-text-muted mb-8 leading-relaxed">
          Run your NFL pick'em pool without the spreadsheet, and follow live scores from every league you care about.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center px-8 py-3 bg-accent hover:opacity-90 text-accent-contrast tracking-tight font-bold text-lg rounded-lg transition-colors"
          >
            Open Wunderelf Sports
          </a>
        </div>
        <p class="mt-4 text-sm text-text-muted">
          Free, with no ads. The iPhone and Android apps are in testing; store links will be added here when they are public.
        </p>
      </div>
      <img
        src="/images/sports/hero.webp"
        width="1600"
        height="1000"
        alt="Three phones showing an NFL scoreboard, a week of pool picks and a box score, under a row of leagues, with a reminder that picks lock in 2 hours"
        class="w-full rounded-xl border border-border-subtle shadow-md"
      />
    </div>
  </section>

  <!-- Features -->
  <section class="py-24 border-y border-border-subtle bg-surface-raised/40">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">What It Does</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard
          title="Weekly Pick'em Pools"
          description="Everyone picks the winner of every game on their phone. Picks lock on their own at kickoff, so nobody picks late and nobody sees yours early."
        />
        <FeatureCard
          title="Standings That Keep Up"
          description="Standings update as games finish, the weekly winner is named the moment the last game ends, and tiebreakers are settled for you."
        />
        <FeatureCard
          title="Commissioner Tools"
          description="Invite members with a link, fix a pick when someone asks, and keep track of who has paid."
        />
        <FeatureCard
          title="Reminders"
          description="Push notifications before picks lock, so nobody misses a week."
        />
        <FeatureCard
          title="Live Scores From 34 Leagues"
          description="NFL, college football, NBA, WNBA, college basketball, MLB, NHL, MLS, NWSL, the top European soccer leagues and the major international tournaments. Box scores, standings, brackets and schedules for every league."
        />
        <FeatureCard
          title="Web, iPhone and Android"
          description="One account across all three. Follow your teams to see their games first, in light or dark mode."
        />
      </div>
    </div>
  </section>

  <!-- Screenshots -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">Screenshots</h2>
        <p class="text-text-muted mt-6 text-sm">Shown with a demo pool. Every member name is made up.</p>
      </div>

      <ScreenshotGallery images={screenshots} portrait />
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 border-y border-border-subtle bg-surface-raised/40">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-6">Start a Pool</h2>
      <p class="text-text-muted mb-10 text-lg">
        Sign up on the web, create a pool and send your group the invite link.
      </p>
      <a
        href={appUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-10 py-4 bg-accent hover:opacity-90 text-accent-contrast tracking-tight font-bold text-xl rounded-lg transition-colors"
      >
        Open Wunderelf Sports
      </a>
      <p class="mt-8 text-sm text-text-muted">
        <a href={`${appUrl}/privacy`} target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors underline">Privacy policy</a>
        <span class="mx-2">·</span>
        <a href="/contact" class="hover:text-accent transition-colors underline">Support</a>
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ElfLogo from "../components/ElfLogo.astro";

import { products as productLinks } from "../data/products";

// Card copy lives here; the links come from the shared products list so they match the footer and contact page.
const cards = [
  {
    page: "/parting-shadows",
    kind: "Game",
    status: "Out now on Steam",
    pitch:
      "A narrative RPG for one to three players. Build a party from 56 classes and play three branching stories, alone or in online co-op.",
    image: "/images/capsule.png",
    fit: "cover",
  },
  {
    page: "/wunderelf-sports",
    kind: "App",
    status: "On the web, phone apps in testing",
    pitch:
      "Weekly pick'em pools for your group and live scores from 34 leagues, on the web, iPhone and Android.",
    image: "/images/products/sports-feature.webp",
    // The banner has text near its left edge, so show it whole rather than crop it.
    fit: "contain",
  },
  {
    page: "/wunderelf-workshop",
    kind: "App",
    status: "Live now",
    pitch:
      "Turns your team's documents into slide decks and reports where every claim cites its source and is fact-checked.",
    image: "/images/workshop/hero.webp",
    fit: "cover",
  },
].map((card) => ({ ...card, ...productLinks.find((p) => p.page === card.page)! }));
---

<BaseLayout title="Home">
  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">

    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <div class="flex justify-center mb-8"><ElfLogo class="w-32 h-32 md:w-40 md:h-40" /></div>
      <h1 class="tracking-tight text-5xl md:text-7xl font-bold mb-6 leading-tight">
        <span class="text-accent">Wunderelf</span> Studios
      </h1>
      <p class="text-xl md:text-2xl text-text-muted mb-10 max-w-2xl mx-auto leading-relaxed">
        An independent studio making games and apps.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#products"
          class="inline-flex items-center justify-center px-8 py-3 bg-accent hover:opacity-90 text-accent-contrast tracking-tight font-bold text-lg rounded-lg transition-colors"
        >
          See What We Make
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center px-8 py-3 border border-border-subtle hover:border-border-strong text-text-muted hover:text-accent tracking-tight font-bold text-lg rounded-lg transition-colors"
        >
          About the Studio
        </a>
      </div>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="py-24 border-y border-border-subtle bg-surface-raised/40 scroll-mt-14">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">What We Make</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {cards.map((p) => (
          <div class="flex flex-col bg-surface border border-border-subtle rounded-xl overflow-hidden">
            <a href={p.page} class="block aspect-video bg-black overflow-hidden border-b border-border-subtle" tabindex="-1" aria-hidden="true">
              <img src={p.image} alt="" class:list={["w-full h-full", p.fit === "contain" ? "object-contain" : "object-cover"]} />
            </a>
            <div class="flex flex-col flex-1 p-6">
              <div class="flex items-center justify-between gap-3 mb-2">
                <span class="text-[11px] font-semibold uppercase tracking-wide text-text-faint">{p.kind}</span>
                <span class="text-[11px] text-text-faint text-right">{p.status}</span>
              </div>
              <h3 class="tracking-tight text-xl font-bold mb-2 text-text">
                <a href={p.page} class="hover:text-accent transition-colors">{p.name}</a>
              </h3>
              <p class="text-sm text-text-muted leading-relaxed flex-1">{p.pitch}</p>
              <div class="mt-6 flex gap-2">
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-track={p.track}
                  data-location="home"
                  class="flex-1 inline-flex items-center justify-center rounded-lg bg-accent px-3 py-2 text-sm font-semibold text-accent-contrast hover:opacity-90 transition-opacity"
                >
                  {p.action}
                </a>
                <a
                  href={p.page}
                  class="flex-1 inline-flex items-center justify-center rounded-lg border border-border-subtle px-3 py-2 text-sm font-semibold text-text hover:border-border-strong transition-colors"
                  aria-label={`Learn more about ${p.name}`}
                >
                  Learn more
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Studio Values -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">What We Believe</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <FeatureCard
          title="Choices That Matter"
          description="In a game, your decisions change the story. In an app, you stay in charge: you review the plan before anything is built, and nothing is decided behind your back."
        />
        <FeatureCard
          title="Right Beats Fast"
          description="Picks lock on time, scores stay current, and every claim in a Workshop document points to its source. We would rather be slow and right than fast and wrong."
        />
        <FeatureCard
          title="Built With Care"
          description="Everything here is designed, built, tested and supported by the same small studio. We would rather ship something we are proud of than rush it out."
        />
      </div>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import FeatureCard from "../components/FeatureCard.astro";
import ScreenshotGallery from "../components/ScreenshotGallery.astro";

// Stills from the same recorded demo as the video.
const screenshots = [
  { src: "/images/workshop/plan.webp", alt: "The plan to review before building, slide by slide" },
  { src: "/images/workshop/building.webp", alt: "Each slide being written and fact-checked" },
  { src: "/images/workshop/deck.webp", alt: "The finished deck, with every slide fact-checked" },
  { src: "/images/workshop/slide.webp", alt: "One slide with its fact-check and sources" },
];

const appUrl = "https://workshop.wunderelfstudios.com";

// Matches Crew's docs/SPEC.md "Plans and documents". Change both together.
const plans = [
  { name: "Basic", price: "$10", per: "a month", documents: "4 documents a month", extra: "Extra documents $2.50 each" },
  { name: "Starter", price: "$20", per: "a month", documents: "10 documents a month", extra: "Extra documents $2.00 each" },
  { name: "Plus", price: "$35", per: "a month", documents: "20 documents a month", extra: "Extra documents $1.75 each" },
  { name: "Pro", price: "$50", per: "a month", documents: "35 documents a month", extra: "Extra documents $1.43 each" },
  { name: "Own key", price: "$5", per: "a person a month", documents: "No document limit", extra: "Runs on your team's own Anthropic account" },
];

const steps = [
  { title: "Ask", text: "Describe what you need in a chat and attach your files: PDF, Word, Excel, PowerPoint, text or CSV." },
  { title: "Clarify", text: "If the request could be read two ways, the Workshop asks before it guesses." },
  { title: "Plan", text: "You review an outline of every slide or section, with the sources each one will use, and change it before anything is written." },
  { title: "Write", text: "Each slide or section is written using only its own sources, in your company template if you have one." },
  { title: "Fact-check", text: "Every claim is checked against its sources and rewritten if it doesn't hold up. Anything that can't be supported becomes a visible placeholder." },
];
---

<BaseLayout
  title="Wunderelf Workshop"
  description="Wunderelf Workshop turns your team's documents into slide decks and reports where every claim cites its source and is fact-checked."
  ogImage="/images/workshop/hero-og.jpg"
>
  <!-- Hero: laid out like the Wunderelf Sports page, text beside the product. -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div class="text-center lg:text-left">
        <h1 class="tracking-tight text-5xl md:text-6xl font-bold mb-4">
          Wunderelf <span class="text-accent">Workshop</span>
        </h1>
        <p class="text-xl text-text-muted mb-8 leading-relaxed">
          Turn your team's documents into slide decks and reports where every claim cites its source and is fact-checked.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
          <a
            href={appUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center whitespace-nowrap px-7 py-3 bg-accent hover:opacity-90 text-accent-contrast font-bold text-lg rounded-lg transition-opacity"
          >
            Open the Workshop
          </a>
          <a
            href="#pricing"
            class="inline-flex items-center justify-center whitespace-nowrap px-7 py-3 border border-border-subtle hover:border-border-strong bg-surface text-text font-semibold text-lg rounded-lg transition-colors"
          >
            See Plans
          </a>
        </div>
        <p class="mt-4 text-sm text-text-muted">Plans start at $10 a month, or try 2 documents for $6.</p>
      </div>
      <img
        src="/images/workshop/hero.webp"
        width="1600"
        height="1000"
        alt="A request with season notes attached becomes a fact-checked slide deck citing those notes"
        class="w-full rounded-xl border border-border-subtle shadow-md"
      />
    </div>
  </section>

  <!-- Demo -->
  <section class="py-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">See It Work</h2>
        <p class="text-text-muted max-w-2xl mx-auto leading-relaxed">
          A board deck from a page of season notes: attach the notes, ask for the deck, review the plan, build.
          The waits while the Workshop plans and writes are sped up.
        </p>
      </div>

      <video
        class="w-full rounded-xl border border-border-subtle bg-surface shadow-md"
        src="/videos/workshop-demo.mp4"
        poster="/images/workshop/deck.webp"
        controls
        muted
        playsinline
        preload="metadata"
        aria-label="Wunderelf Workshop demo: building a six-slide board deck from attached notes"
      ></video>
      <p class="mt-3 text-center text-xs text-text-faint">Recorded with made-up sample data.</p>

      <div class="mt-12">
        <ScreenshotGallery images={screenshots} columns={2} />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="py-24 border-y border-border-subtle bg-surface-raised/40">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">How It Works</h2>
      </div>

      <ol class="space-y-8">
        {steps.map((step, i) => (
          <li class="flex gap-6">
            <div class="shrink-0 w-12 h-12 bg-surface border border-border-subtle rounded-lg flex items-center justify-center tracking-tight text-xl font-bold text-accent">
              {i + 1}
            </div>
            <div>
              <h3 class="tracking-tight text-xl font-bold mb-1 text-text">{step.title}</h3>
              <p class="text-text-muted leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Features -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">What You Get</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <FeatureCard
          title="Decks and Documents"
          description="PowerPoint decks, Word documents and web pages, and every one also downloads as a PDF."
        />
        <FeatureCard
          title="Cited Sources"
          description="Documents carry numbered citations and a sources list, so anyone can see where each claim came from."
        />
        <FeatureCard
          title="Your Template"
          description="Upload a PowerPoint or Word template and the result uses your colors, fonts and layouts. Without one, a built-in theme gives the same polish."
        />
        <FeatureCard
          title="Changes in Plain Words"
          description="Ask for a change to one slide or section at a time. The rest of the document stays as it was, and you can undo."
        />
        <FeatureCard
          title="Team Accounts"
          description="Invite your team, share a plan, and keep each team's files and documents separate from every other team's."
        />
        <FeatureCard
          title="Remembers Your Preferences"
          description="Standing preferences, such as a favorite format or template, carry over to every new chat."
        />
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-24 border-y border-border-subtle bg-surface-raised/40 scroll-mt-14">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-4">Plans and Prices</h2>
        <p class="text-text-muted mt-6 max-w-2xl mx-auto leading-relaxed">
          A document is one chat, counted once at its first build. Revisions are included. Prices are in US dollars, billed monthly, with tax added at checkout.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {plans.map((plan) => (
          <div class="bg-surface border border-border-subtle rounded-xl p-6 flex flex-col">
            <h3 class="tracking-tight text-xl font-bold text-text mb-2">{plan.name}</h3>
            <p class="mb-4">
              <span class="tracking-tight text-4xl font-bold text-accent">{plan.price}</span>
              <span class="text-sm text-text-muted"> {plan.per}</span>
            </p>
            <p class="text-sm text-text mb-2">{plan.documents}</p>
            <p class="text-xs text-text-muted leading-relaxed">{plan.extra}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 max-w-3xl mx-auto text-sm text-text-muted leading-relaxed space-y-3">
        <p>
          <span class="text-text font-medium">Not ready for a plan?</span> Buy 2 documents for $6, as often as you like. They never expire.
        </p>
        <p>
          <span class="text-text font-medium">Extra documents</span> are bought five at a time, never expire, and stay usable after a plan ends.
        </p>
        <p>
          <span class="text-text font-medium">Fair use:</span> one chat can spend up to $3 of model time on changes. After that, start a new chat. Own key plans have no limit.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="tracking-tight text-3xl md:text-4xl font-bold mb-6">Make Your First Deck</h2>
      <p class="text-text-muted mb-10 text-lg">
        Sign in, attach your files and describe what you need. You review the plan before anything is written.
      </p>
      <a
        href={appUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-10 py-4 bg-accent hover:opacity-90 text-accent-contrast font-bold text-xl rounded-lg transition-opacity"
      >
        Open Wunderelf Workshop
      </a>
      <p class="mt-8 text-sm text-text-muted">
        Questions about plans, or whether the Workshop fits your team's work?
        <a href="/contact?subject=workshop" class="text-accent font-medium underline">Get in touch</a>.
      </p>
      <p class="mt-3 text-sm text-text-muted">
        <a href={`${appUrl}/terms`} target="_blank" rel="noopener noreferrer" class="hover:text-text underline">Terms</a>
        <span class="mx-2">·</span>
        <a href={`${appUrl}/privacy`} target="_blank" rel="noopener noreferrer" class="hover:text-text underline">Privacy policy</a>
      </p>
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../data/products";
---

<BaseLayout title="Contact" description="Contact Wunderelf Studios for general inquiries, press, support for our games and apps, or to work together.">
  <section class="py-24">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-16">
        <h1 class="tracking-tight text-4xl md:text-5xl font-bold mb-4">Get in Touch</h1>
        <p class="text-text-muted mt-6 max-w-xl mx-auto">
          Questions about Parting Shadows, Wunderelf Sports or Wunderelf Workshop, press requests, or a project you'd like to work on together: we'd love to hear from you.
        </p>
      </div>

      <!-- Contact methods -->
      <div class="mb-6">
        <div class="bg-surface border border-border-subtle rounded-xl p-8 text-center">
          <div class="flex justify-center mb-4">
            <svg class="w-8 h-8 text-text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="tracking-tight text-lg font-bold mb-2">General Inquiries</h3>
          <button id="copy-email" data-email="wunderelfstudios@gmail.com" class="text-accent hover:text-accent transition-colors text-sm cursor-pointer">
            wunderelfstudios@gmail.com
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-16">
        {products.map((p) => (
          <div class="bg-surface border border-border-subtle rounded-xl p-5 text-center">
            <h3 class="text-base font-semibold mb-1">{p.name}</h3>
            <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-sm text-accent font-medium" data-track={p.track} data-location="contact">
              {p.action}
            </a>
          </div>
        ))}
      </div>

      <!-- Contact form (works with Netlify Forms) -->
      <div class="bg-surface border border-border-subtle rounded-xl p-8">
        <h2 class="tracking-tight text-2xl font-bold mb-6 text-center">Send a Message</h2>

        <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-6">
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden"><input name="bot-field" /></p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-sm font-medium text-text-muted mb-2">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-surface-raised border border-border-subtle rounded-lg text-text placeholder:text-text-faint focus:outline-none focus:border-accent transition-colors"
                placeholder="Your name"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-text-muted mb-2">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 bg-surface-raised border border-border-subtle rounded-lg text-text placeholder:text-text-faint focus:outline-none focus:border-accent transition-colors"
                placeholder="you@example.com"
              />
            </div>
          </div>

          <div>
            <label for="subject" class="block text-sm font-medium text-text-muted mb-2">Subject</label>
            <select
              id="subject"
              name="subject"
              class="w-full px-4 py-3 bg-surface-raised border border-border-subtle rounded-lg text-text focus:outline-none focus:border-accent transition-colors"
            >
              <option value="general">General inquiry</option>
              <option value="work">Work together</option>
              <option value="sports">Wunderelf Sports support</option>
              <option value="workshop">Wunderelf Workshop</option>
              <option value="parting-shadows">Parting Shadows support</option>
              <option value="press">Press and media</option>
              <option value="feedback">Feedback</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text-muted mb-2">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full px-4 py-3 bg-surface-raised border border-border-subtle rounded-lg text-text placeholder:text-text-faint focus:outline-none focus:border-accent transition-colors resize-y"
              placeholder="What's on your mind?"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3 bg-accent hover:opacity-90 text-accent-contrast tracking-tight font-bold text-lg rounded-lg transition-colors cursor-pointer"
          >
            Send Message
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Toast notification -->
  <div id="copy-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-surface border border-border-strong rounded-lg px-6 py-3 text-sm text-text shadow-lg transition-opacity duration-300 opacity-0 pointer-events-none z-50">
    Email copied to clipboard
  </div>

  <script>
    // Links such as /contact?subject=workshop open the form with that subject chosen.
    const subjectSelect = document.getElementById("subject") as HTMLSelectElement | null;
    const requested = new URLSearchParams(window.location.search).get("subject");
    if (subjectSelect && requested && [...subjectSelect.options].some((o) => o.value === requested)) {
      subjectSelect.value = requested;
    }

    const copyBtn = document.getElementById("copy-email");
    const toast = document.getElementById("copy-toast");
    let hideTimeout: number;

    copyBtn?.addEventListener("click", async () => {
      const email = (copyBtn as HTMLElement).dataset.email;
      if (!email) return;
      await navigator.clipboard.writeText(email);
      if (toast) {
        clearTimeout(hideTimeout);
        toast.classList.remove("opacity-0");
        toast.classList.add("opacity-100");
        hideTimeout = window.setTimeout(() => {
          toast.classList.remove("opacity-100");
          toast.classList.add("opacity-0");
        }, 2000);
      }
    });
  </script>
</BaseLayout>
